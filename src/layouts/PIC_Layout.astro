---
import Footer from "../components/PIC_LP/PIC_Footer.astro";
import Header from "../components/PIC_LP/PIC_Header.astro";
import BaseHead from "../components/BaseHead.astro";

const {
  title,
  description = "Aiskrim kelapa original Thailand di Shah Alam. Lembut, segar dan topping percuma. Dari RM4 secawan — singgah gerai kami atau tempah untuk majlis anda.",
  permalink = Astro.url.href,
} = Astro.props;

// Structured data so Google can show hours, location and price range
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "IceCreamShop",
  name: "Paman Ice Cream",
  description,
  url: permalink,
  telephone: "+60182876201",
  priceRange: "RM4 - RM8",
  servesCuisine: "Aiskrim Kelapa",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jalan Nelayan 19/B, Seksyen 19",
    addressLocality: "Shah Alam",
    postalCode: "40300",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  geo: { "@type": "GeoCoordinates", latitude: 3.0493479, longitude: 101.5343549 },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Sunday", "Monday", "Wednesday", "Thursday", "Saturday"],
      opens: "11:30",
      closes: "17:00",
    },
  ],
};
---

<!doctype html>
<html lang="ms">
  <head>
    <BaseHead title={title} description={description} permalink={permalink} />
    <meta name="theme-color" content="#fffaf0" />
    <link rel="icon" type="image/x-icon" href="/faviconPIC.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Lora:ital,wght@0,500..700;1,500..700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/images/pamanIceCream/iceCream.webp"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="pic">
    <div class="layout">
      <Header />
      <main class="pic-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  /* Tokens live on body.pic so they beat the blog's :root tokens from global.css */
  body.pic {
    color-scheme: light;

    --pic-cream: #fffaf0;
    --pic-cream-2: #f2fbe8;
    --pic-surface: #ffffff;
    --pic-ink: #14301b;
    --pic-ink-soft: #4d6352;
    --pic-ink-faint: #7d8f80;
    --pic-line: #e3ecd9;

    --pic-green: #1dc917; /* brand */
    --pic-green-deep: #0f7a0c; /* accessible on cream */
    --pic-green-soft: #c9f5c4;
    --pic-coconut: #7a4b25;
    --pic-pink: #ff6b9a;
    --pic-yellow: #ffd23f;
    --pic-wa: #25d366;

    --pic-shadow: 0 18px 40px -18px rgba(20, 48, 27, 0.35);
    --pic-radius: 22px;

    --font-family-sans: "Fredoka", system-ui, sans-serif;
    --font-family-highlight: "Lora", serif;

    margin: 0;
    font-family: var(--font-family-sans);
    background-color: var(--pic-cream);
    color: var(--pic-ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* Neutralise blog typography that leaks in through BaseHead → global.css */
  body.pic h1,
  body.pic h2,
  body.pic h3 {
    font-family: var(--font-family-sans);
    margin: 0;
  }
  body.pic p,
  body.pic ul,
  body.pic ol {
    font-size: 1rem;
    margin: 0;
  }
  body.pic ul {
    padding: 0;
  }
  body.pic li {
    margin: 0;
  }
  body.pic a:hover {
    color: inherit;
  }
  body.pic p a {
    box-shadow: none;
  }

  html:has(body.pic) {
    scroll-behavior: smooth;
    scroll-padding-top: 72px;
  }

  .pic .layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow-x: clip;
  }

  .pic-main {
    flex: 1;
    width: 100%;
  }

  /* Shared section heading pattern */
  .pic-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pic-green-deep);
    background: var(--pic-green-soft);
    padding: 5px 14px;
    border-radius: 99px;
  }

  .pic-heading {
    font-family: var(--font-family-highlight) !important;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--pic-ink);
    margin-top: 0.75rem !important;
  }

  .pic-heading em {
    font-style: italic;
    color: var(--pic-green-deep);
  }

  /* Scroll-reveal. JS only hides elements that start below the fold, and uses an
     animation on `translate` so it never fights a component's own transform/transition. */
  [data-reveal].reveal-pending {
    opacity: 0;
  }
  [data-reveal].is-visible {
    animation: picReveal 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes picReveal {
    from {
      opacity: 0;
      translate: 0 24px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html:has(body.pic) {
      scroll-behavior: auto;
    }
    .pic *,
    .pic *::before,
    .pic *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initReveal() {
    if (!("IntersectionObserver" in window)) return;
    const items = Array.from(
      document.querySelectorAll<HTMLElement>("[data-reveal]"),
    ).filter((el) => el.getBoundingClientRect().top > window.innerHeight);
    if (items.length === 0) return;

    const show = (el: Element) => {
      el.classList.remove("reveal-pending");
      el.classList.add("is-visible");
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            show(e.target);
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0 },
    );
    items.forEach((el) => {
      el.classList.add("reveal-pending");
      io.observe(el);
    });

    // Failsafe: never leave content hidden (e.g. jump links, print, odd browsers)
    window.addEventListener("hashchange", () => items.forEach(show), { once: true });
  }

  document.addEventListener("astro:page-load", initReveal);
</script>
