---
const sizes = [
  {
    label: "Kecil",
    price: "RM4",
    desc: "Terbaik untuk merasa pertama kali",
    scale: 0.72,
    popular: false,
  },
  {
    label: "Sederhana",
    price: "RM6",
    desc: "Pilihan terbaik untuk semua orang",
    scale: 0.86,
    popular: true,
  },
  {
    label: "Besar",
    price: "RM8",
    desc: "Buat pelanggan setia kami yang ingin lebih",
    scale: 1,
    popular: false,
  },
];

const toppings = [
  { name: "Roti", icon: "🍞" },
  { name: "Nata de Coco", icon: "🥥" },
  { name: "Sprinkle", icon: "🌈" },
  { name: "Kacang Hancur", icon: "🥜" },
  { name: "Koko Krunch", icon: "🥣" },
  { name: "Susu", icon: "🥛" },
  { name: "Pulut", icon: "🍚" },
  { name: "Jagung", icon: "🌽" },
];
---

<section id="menu" class="menu-section">
  <div class="menu-inner">
    <!-- Section header -->
    <div class="menu-header" data-reveal>
      <span class="pic-eyebrow">Apa yang kami tawarkan</span>
      <h2 class="pic-heading">Pilih <em>saiz</em> anda</h2>
      <p class="menu-subtitle">
        Aiskrim kelapa asli Thailand &mdash; semua saiz, satu rasa
      </p>
    </div>

    <!-- Size comparison photo -->
    <div class="showcase-banner" data-reveal>
      <img
        src="/assets/images/pamanIceCream/cupSize.webp"
        alt="Perbandingan saiz cawan aiskrim Paman — Besar, Sederhana, Kecil"
        class="showcase-banner__img"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Size cards -->
    <div class="size-grid">
      {
        sizes.map((s, i) => (
          <div
            class:list={["size-card", { "size-card--popular": s.popular }]}
            data-reveal
            style={`animation-delay:${i * 90}ms`}
          >
            {s.popular && (
              <span class="size-card__badge">Paman Pick 🍦</span>
            )}
            <img
              class="size-card__img"
              src="/assets/images/pamanIceCream/iceCream.webp"
              alt=""
              loading="lazy"
              decoding="async"
              style={`--s:${s.scale}`}
            />
            <span class="size-card__tier">Saiz</span>
            <strong class="size-card__label">{s.label}</strong>
            <p class="size-card__price">
              {s.price}
              <span>/cawan</span>
            </p>
            <p class="size-card__desc">{s.desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Toppings -->
    <div class="topping-box" data-reveal>
      <div class="topping-box__head">
        <h3>Topping pilihan anda</h3>
        <span class="topping-box__free">PERCUMA</span>
      </div>

      <p class="topping-label">
        Semua topping percuma dengan setiap pembelian &middot; Tiada tambahan
        bayaran &middot; Pilih sesuka hati.
      </p>

      <ul class="topping-list" aria-label="Senarai topping percuma">
        {
          toppings.map((t) => (
            <li class="topping-pill">
              <span aria-hidden="true">{t.icon}</span>
              {t.name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── Section shell ───────────────────────────────────── */
  .menu-section {
    width: 100%;
    padding: clamp(4rem, 8vw, 6rem) 1.5rem;
    background:
      radial-gradient(50% 40% at 0% 0%, rgba(29, 201, 23, 0.1), transparent 70%),
      var(--pic-cream-2);
  }

  .menu-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Header ──────────────────────────────────────────── */
  .menu-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .menu-subtitle {
    margin-top: 0.6rem !important;
    font-size: 1.05rem !important;
    color: var(--pic-ink-soft);
  }

  /* ── Showcase banner ─────────────────────────────────── */
  .showcase-banner {
    width: min(100%, 720px);
    margin: 0 auto 3.5rem;
    padding: 10px;
    background: #fff;
    border-radius: var(--pic-radius);
    box-shadow: var(--pic-shadow);
    rotate: -1deg;
    transition: rotate 0.4s ease;
  }

  .showcase-banner:hover {
    rotate: 0deg;
  }

  .showcase-banner__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--pic-radius) - 8px);
  }

  /* ── Size cards ──────────────────────────────────────── */
  .size-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .size-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 1.5rem 1.25rem 1.6rem;
    border-radius: var(--pic-radius);
    background: #fff;
    border: 1.5px solid var(--pic-line);
    text-align: center;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .size-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--pic-shadow);
    border-color: var(--pic-green-soft);
  }

  .size-card--popular {
    border: 2px solid var(--pic-green);
    box-shadow: 0 20px 40px -20px rgba(15, 122, 12, 0.45);
    padding-block: 2rem;
  }

  .size-card__badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pic-green-deep);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 99px;
    white-space: nowrap;
  }

  /* Same cup, scaled per size so the difference reads at a glance */
  .size-card__img {
    height: calc(110px * var(--s));
    width: auto;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 10px 12px rgba(20, 48, 27, 0.18));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.3, 1.4);
  }

  .size-card:hover .size-card__img {
    transform: translateY(-4px) rotate(-4deg);
  }

  .size-card__tier {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pic-ink-faint);
  }

  .size-card__label {
    font-family: var(--font-family-highlight);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--pic-ink);
    line-height: 1;
  }

  .size-card__price {
    font-size: 2.5rem !important;
    font-weight: 700;
    color: var(--pic-green-deep);
    line-height: 1;
    margin-top: 4px !important;
  }

  .size-card__price span {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--pic-ink-faint);
  }

  .size-card__desc {
    font-size: 0.9rem !important;
    color: var(--pic-ink-soft);
    line-height: 1.45;
  }

  /* ── Toppings ────────────────────────────────────────── */
  .topping-box {
    background: #fff;
    border-radius: var(--pic-radius);
    border: 1.5px dashed rgba(29, 201, 23, 0.4);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    text-align: center;
  }

  .topping-box__head {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .topping-box__head h3 {
    font-family: var(--font-family-highlight) !important;
    font-size: 1.5rem;
    color: var(--pic-ink);
  }

  .topping-box__free {
    background: var(--pic-yellow);
    color: var(--pic-ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 10px;
    border-radius: 99px;
    rotate: -4deg;
  }

  .topping-label {
    font-size: 0.95rem !important;
    color: var(--pic-ink-soft);
    margin: 0.5rem 0 1.5rem !important;
  }

  .topping-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    list-style: none;
  }

  .topping-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 99px;
    background: var(--pic-cream);
    border: 1px solid var(--pic-line);
    color: var(--pic-ink);
    font-size: 15px;
    font-weight: 500;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .topping-pill:hover {
    transform: translateY(-3px) rotate(-2deg);
    background: var(--pic-green-soft);
    border-color: var(--pic-green);
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 680px) {
    .size-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin-inline: auto;
    }

    .size-card--popular {
      order: -1;
    }
  }
</style>
